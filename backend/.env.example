# Copy this file to .env and change the values before running.
FLASK_ENV=development
SECRET_KEY=replace-this-with-a-long-random-secret
JWT_SECRET_KEY=replace-this-with-another-long-random-secret
FRONTEND_ORIGIN=http://127.0.0.1:5173
# Optional PostgreSQL example: postgresql+psycopg://user:password@localhost:5432/securelab
# DATABASE_URL=postgresql+psycopg://securelab_user:change-me@localhost:5432/securelab
MAX_CONTENT_LENGTH_MB=12
ACCESS_TOKEN_MINUTES=30

# Only used by `flask seed-demo`; change these immediately if you use the demo accounts.
DEMO_ADMIN_EMAIL=admin@securelab.local
DEMO_ADMIN_PASSWORD=AdminDemo!2026
DEMO_LAB_EMAIL=lab@securelab.local
DEMO_LAB_PASSWORD=LabDemo!2026
